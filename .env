# ============================================================
# 环境变量（本文件无机密，可提交仓库）
# 所有 API 地址一律经此管理，代码中严禁硬编码
# ============================================================

# ---- 页面数据源 ----
# 新闻 JSON 地址（相对路径，适用于 base:'./' 的任意子路径部署）
VITE_NEWS_URL=./data/news.json
# 离线 Mock 数据目录（请求全部失败后的最终兜底）
VITE_MOCK_BASE=./data/mock/
# 预留：真实后端 API 地址（当前为纯静态架构，留空即不使用）
VITE_API_BASE_URL=

# ---- Mock 登录（仅演示，README 已注明）----
VITE_MOCK_USER=admin
VITE_MOCK_PASSWORD=admin123
# Token 有效期（毫秒），2 小时
VITE_TOKEN_TTL_MS=7200000

# ---- 测试开关 ----
# auto | network | cache | mock
# auto：正常三级降级链路；其他值强制使用对应来源（便于演示/验收）
VITE_FORCE_SOURCE=auto
